# ════════════════════════════════════════════════════════════════
# GARAGE SUIVI — Variables d'environnement PRODUCTION
# ⚠️ Ne JAMAIS commiter ce fichier rempli dans Git !
# Copiez ce fichier en .env et remplissez les vraies valeurs.
# ════════════════════════════════════════════════════════════════

# ─── Django ────────────────────────────────────────────────────
# Générez une clé avec :
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=remplacez-moi-par-une-cle-aleatoire-de-50-caracteres

ALLOWED_HOSTS=garage.votredomaine.com,www.garage.votredomaine.com
CSRF_TRUSTED_ORIGINS=https://garage.votredomaine.com,https://www.garage.votredomaine.com
CORS_ORIGINS=https://garage.votredomaine.com

# ─── Base de données ───────────────────────────────────────────
DB_NAME=garage_db_prod
DB_USER=garage_prod_user
DB_PASSWORD=CHANGEZ-MOI-mot-de-passe-tres-fort-32-caracteres
DB_HOST=db
DB_PORT=5432

# ─── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGEZ-MOI-aussi-mot-de-passe-redis-fort

# ─── Email (pour notifications + alertes erreurs admin) ──────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-compte@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-application-gmail
DEFAULT_FROM_EMAIL=garage@votredomaine.com
ADMIN_EMAIL=admin@votredomaine.com

# ─── Monitoring (optionnel mais fortement recommandé) ────────────
# Créez un compte gratuit sur https://sentry.io
SENTRY_DSN=

# ─── Sauvegardes ─────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14
